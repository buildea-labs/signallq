# Site público SignallQ — variáveis de build do Next.js. Nenhum valor sensível
# aqui: SITE_INGEST_KEY é secret apenas do servidor, nunca uma variável
# NEXT_PUBLIC_* (essas entram no bundle do navegador).

# Link oficial de distribuição Beta do app SignallQ (Firebase App Distribution
# ou Play Console). Já tem default real no código (config.ts) apontando pra
# Play Store — só preencha aqui se precisar sobrescrever (ex.: trocar pra link
# de Firebase App Distribution num ambiente de teste).
NEXT_PUBLIC_SIGNALLQ_BETA_DOWNLOAD_URL=

# Grupo oficial para participar do teste fechado. Tem prioridade sobre o
# link da Play Store, pois é a etapa de elegibilidade do programa de teste.
NEXT_PUBLIC_SIGNALLQ_TEST_GROUP_URL=https://groups.google.com/g/testadores-signallq

# URL da página de teste fechado na Play Store.
NEXT_PUBLIC_SIGNALLQ_CLOSED_TESTING_URL=

# Google AdSense — publisher ID público, gate de carregamento do script real
# (`AdSenseScript`, junto com o consentimento de cookies do usuário). Em
# produção, configure como env var do projeto de hospedagem; não use secret
# porque NEXT_PUBLIC_* entra no bundle do navegador.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Slot ID da única unidade de anúncio autorizada (issue #21) — `ResultAdSlot`,
# exibida só depois do resultado completo e suas ações. Sem esta env var
# configurada, o slot nunca renderiza, mesmo com publisher id e consentimento
# aceito.
NEXT_PUBLIC_ADSENSE_RESULT_AD_SLOT=

# Motor de medição real de /teste-de-velocidade (src/lib/config.ts) — default
# já aponta para speed.cloudflare.com/__down|__up. Só sobrescreva se for
# trocar por um endpoint de medição próprio.
NEXT_PUBLIC_SPEEDTEST_DOWNLOAD_URL=
NEXT_PUBLIC_SPEEDTEST_UPLOAD_URL=

# Secret somente do servidor para os proxies /api/track e /api/waitlist.
SITE_INGEST_KEY=

# URL do Worker oficial de diagnóstico. Configuração somente do servidor: nunca
# use NEXT_PUBLIC_ nem inclua esse valor em código cliente.
DIAGNOSTIC_WORKER_URL=

# Backend do signallq-plans (issues #4-#9/#13, concluídas e deployadas) —
# GET /api/v1/location, GET /api/v1/offers e POST /api/v1/recommendations.
# Configuração somente do servidor: as Route Handlers de /api/planos/*
# repassam a chamada, o navegador nunca fala direto com este host nem com
# ViaCEP. Sem valor aqui, /planos responde com estado de erro tratado
# ("serviço indisponível") em vez de apontar para uma URL inventada. Worker
# real: https://signallq-plans.buildealabs.workers.dev — configure este
# valor em produção via `vercel env add` (não versionado aqui de propósito;
# ver docs/deploy-vercel.md).
SIGNALLQ_PLANS_API_URL=

# Chave de autenticação do signallq-plans, se/quando o backend exigir uma.
# Nunca NEXT_PUBLIC_. Hoje o Worker não exige — enquanto vazia, as chamadas
# seguem sem header de autorização.
SIGNALLQ_PLANS_API_KEY=
